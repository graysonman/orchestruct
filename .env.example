# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=orchestruct
POSTGRES_PASSWORD=changeme
POSTGRES_DB=orchestruct_dev
# Note: hostname is "postgres" — the Docker Compose service name, not localhost
DATABASE_URL=postgresql://orchestruct:changeme@postgres:5432/orchestruct_dev

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── FastAPI / JWT ──────────────────────────────────────────────────────────────
# Generate a real key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Google OAuth / Calendar ────────────────────────────────────────────────────
# All three are OPTIONAL. Leave them blank and Google login/sync stays disabled:
# /api/v1/auth/google returns 501 and the rest of the app works normally.
#
# To enable, create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and enable the
# "Google Calendar API" for the same project.
#
# GOOGLE_REDIRECT_URI must be registered verbatim under "Authorized redirect
# URIs" in that console — Google string-matches it, and the same value is sent
# again during the code exchange. A trailing-slash mismatch fails the exchange.
# Note it points at the NEXT.JS callback (port 3000), not FastAPI: the browser
# is redirected to the frontend, which then calls the backend server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
